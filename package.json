{
  "name": "dsh-plugin-swipe-nav",
  "version": "0.4.0",
  "description": "Edge-swipe navigation for the DeepSeek Harness Web GUI: swipe in from the left edge for sessions and from the right edge for the tools column, swipe back to close.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xffxff/dsh-swipe-nav.git"
  },
  "homepage": "https://github.com/xffxff/dsh-swipe-nav#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "swipe",
    "mobile"
  ],
  "license": "MIT"
}
